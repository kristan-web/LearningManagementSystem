# Learning Management System - Laravel Application
# Environment Configuration Template
# 
# Copy this file to .env and customize for your environment:
# cp .env.example .env
#
# IMPORTANT: Never commit your actual .env file to version control!
# Generate your application key: php artisan key:generate

APP_NAME="Learning Management System"
APP_ENV=local
APP_KEY=base64:ekeIGIpfmUxWMhDJechV+fbCYhNJ7uPChjYG/lY0URs=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database Configuration
# Default: MySQL (e.g. via XAMPP). Create the database below first
# (phpMyAdmin > New, or `mysql -u root -e "CREATE DATABASE enrollment_management_system"`),
# then run: php artisan migrate
#
# Alternative: SQLite (no DB server needed). Set DB_CONNECTION=sqlite and
# create an empty file at database/database.sqlite — all other DB_* settings
# below are then ignored.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enrollment_management_system
DB_USERNAME=root
DB_PASSWORD=

# Session, cache and queue all use the "database" driver, so their tables
# (sessions, cache, jobs) are created by the same `php artisan migrate` above
# — no extra setup needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Other Services
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="${APP_NAME}"
BREVO_LOGO_URL=
